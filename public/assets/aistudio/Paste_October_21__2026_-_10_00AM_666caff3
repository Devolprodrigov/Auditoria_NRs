<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafetyAudit Master - Sistema Integrado de Auditorias (NR-12, NR-10, NR-06, NR-17, NR-23)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 50: '#f0fdf4', 500: '#22c55e', 600: '#16a34a', 700: '#15803d', 900: '#14532d' },
                        slate: { 850: '#1e293b' }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; font-size: 11pt; }
            .print-shadow { box-shadow: none !important; border: 1px solid #cbd5e1 !important; }
            input, select, textarea { border: 1px solid #94a3b8 !important; background: transparent !important; }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Header -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-50 no-print">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-500 text-slate-900 p-2.5 rounded-xl font-bold text-xl flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide">SafetyAudit <span class="text-emerald-400">Master</span></h1>
                    <p class="text-xs text-slate-400">Plataforma Integrada de Auditoria de Segurança (NR-12, NR-10, NR-06, NR-17, NR-23)</p>
                </div>
            </div>
            <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end flex-wrap">
                <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg text-sm font-medium border border-slate-700 transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-print"></i> Relatório / Imprimir PDF
                </button>
                <button onclick="exportJSON()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg text-sm font-medium border border-slate-700 transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-file-code"></i> Exportar Dados
                </button>
                <button onclick="resetChecklist()" class="bg-rose-900/40 hover:bg-rose-900 text-rose-200 px-3 py-2 rounded-lg text-sm font-medium border border-rose-800 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-right"></i> Reiniciar
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 space-y-8 flex-grow w-full">

        <!-- Identification Card -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 print-shadow">
            <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-file-contract text-emerald-600"></i> Identificação da Auditoria, Posto de Trabalho e Equipamento
                </h2>
                <span class="text-xs bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full font-semibold border border-emerald-200">Múltiplas NRs</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Empresa / Unidade / Planta</label>
                    <input type="text" id="info-empresa" placeholder="Ex: Indústria Metalúrgica Central" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nome da Máquina / Posto / Área</label>
                    <input type="text" id="info-posto" placeholder="Ex: Célula de Solda Robotizada 02" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Tag / Patrimônio / ID</label>
                    <input type="text" id="info-tag" placeholder="Ex: ROB-SOL-02" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Setor / Departamento</label>
                    <input type="text" id="info-setor" placeholder="Ex: Linha de Montagem Final" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Inspetor Responsável (Técnico/Engenheiro)</label>
                    <input type="text" id="info-inspetor" placeholder="Nome Completo / CREA ou MTE" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Data da Inspeção</label>
                    <input type="date" id="info-data" onchange="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Responsável pela Área Acompanhante</label>
                    <input type="text" id="info-responsavel" placeholder="Nome do Líder / Gestor do Setor" oninput="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Parecer Técnico Global</label>
                    <select id="info-parecer" onchange="saveInfo()" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        <option value="Aprovado / Liberado">Aprovado / Liberado</option>
                        <option value="Liberado com Restrições (Plano de Ação)">Liberado com Restrições (Plano de Ação)</option>
                        <option value="Interditado / Paralisado (Grave e Iminente)">Interditado / Paralisado (Grave e Iminente)</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Dynamic Dashboard Summary Cards -->
        <section class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total de Itens</p>
                    <p id="stat-total" class="text-3xl font-extrabold text-slate-900 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600">
                    <i class="fa-solid fa-list-check text-xl"></i>
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Conformes (C)</p>
                    <p id="stat-c" class="text-3xl font-extrabold text-emerald-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <i class="fa-solid fa-check text-xl"></i>
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-rose-600 uppercase tracking-wider">Não Conformes (NC)</p>
                    <p id="stat-nc" class="text-3xl font-extrabold text-rose-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600">
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-amber-600 uppercase tracking-wider">Não Aplicáveis (NA)</p>
                    <p id="stat-na" class="text-3xl font-extrabold text-amber-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600">
                    <i class="fa-solid fa-ban text-xl"></i>
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between col-span-2 sm:col-span-2 lg:col-span-1">
                <div class="w-full">
                    <div class="flex justify-between items-center mb-1">
                        <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Conformidade</p>
                        <p id="stat-pct" class="text-sm font-bold text-emerald-700">0%</p>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                        <div id="stat-bar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filters & Navigation Bar -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row justify-between items-center gap-4 no-print">
            <!-- Filter Tabs -->
            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                <span class="text-xs font-bold text-slate-500 uppercase mr-1">Filtrar:</span>
                <button onclick="setFilter('ALL')" id="filter-btn-ALL" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white transition shadow-sm">Todos</button>
                <button onclick="setFilter('NC')" id="filter-btn-NC" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition">Somente Não Conformes (NC)</button>
                <button onclick="setFilter('C')" id="filter-btn-C" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">Conformes (C)</button>
                <button onclick="setFilter('NA')" id="filter-btn-NA" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">Não Aplicáveis (NA)</button>
            </div>
            <!-- Search Bar -->
            <div class="w-full md:w-72 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                    <i class="fa-solid fa-search text-xs"></i>
                </span>
                <input type="text" id="search-input" oninput="renderChecklist()" placeholder="Pesquisar requisito ou NR..." class="w-full pl-9 pr-4 py-1.5 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>
        </section>

        <!-- NR Sections Container -->
        <div id="nr-sections-container" class="space-y-6">
            <!-- Dynamic Content -->
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-12 text-center text-xs text-slate-500 no-print">
        <p>SafetyAudit Master &bull; Sistema Integrado de Conformidade com as Normas Regulamentadoras do Ministério do Trabalho e Emprego.</p>
    </footer>

    <!-- Fullscreen Image Lightbox Modal -->
    <div id="image-modal" class="fixed inset-0 bg-slate-900/80 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-3xl w-full p-4 relative shadow-2xl">
            <button onclick="closeModal()" class="absolute top-4 right-4 bg-slate-100 hover:bg-slate-200 text-slate-700 w-8 h-8 rounded-full flex items-center justify-center font-bold">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="font-bold text-slate-900 mb-3 text-base">Evidência Fotográfica Ampliada</h3>
            <div class="flex justify-center bg-slate-900 rounded-xl overflow-hidden p-2">
                <img id="modal-img" src="" class="max-h-[70vh] object-contain rounded-lg">
            </div>
        </div>
    </div>

    <!-- Application Script -->
    <script>
        // Complete Multi-NR Audit Database (NR-12, NR-10, NR-06, NR-17, NR-23)
        const safetyDatabase = [
            {
                nr: "NR-12",
                title: "NR-12: Segurança em Máquinas e Equipamentos",
                badgeColor: "bg-blue-50 text-blue-700 border-blue-200",
                items: [
                    { id: "12.1", code: "Item 12.4", text: "Arranjo físico e instalações: Espaços ao redor das máquinas adequados para operação, manutenção, limpeza e inspeção sem riscos de esmagamento." },
                    { id: "12.2", code: "Item 12.38", text: "Proteções fixas e móveis: Zonas de perigo guarnecidas por proteções físicas resistentes, sem vãos excessivos ou facilidade de burla." },
                    { id: "12.3", code: "Item 12.42", text: "Dispositivos de intertravamento: Chaves de segurança intertravadas em proteções móveis que paralisam imediatamente o funcionamento perigoso." },
                    { id: "12.4", code: "Item 12.56", text: "Paradas de emergência: Botões de emergência (cogumelo vermelho em fundo amarelo) em número suficiente, acessíveis e operantes." },
                    { id: "12.5", code: "Item 12.111", text: "Manuais e Instruções: Manual de instruções da máquina disponível no estabelecimento, em língua portuguesa, de fácil acesso aos operadores." }
                ]
            },
            {
                nr: "NR-10",
                title: "NR-10: Segurança em Instalações e Serviços em Eletricidade",
                badgeColor: "bg-amber-50 text-amber-700 border-amber-200",
                items: [
                    { id: "10.1", code: "Item 10.2.8", text: "Aterramento e Proteção: Instalações elétricas dotadas de sistema de aterramento adequado e dispositivos de proteção contra sobrecorrente e choque." },
                    { id: "10.2", code: "Item 10.3.9", text: "Prontuário e Diagramas: Esquemas unifilares atualizados das instalações elétricas disponíveis e mantidos organizados." },
                    { id: "10.3", code: "Item 10.4.1", text: "Painéis e Quadros Elétricos: Mantidos trancados, identificados quanto ao risco elétrico, limpos e livres de obstrução." },
                    { id: "10.4", code: "Item 10.2.9", text: "Segurança contra Contato Direto: Ausência de condutores expostos, emendas precárias (gambiarras) ou partes energizadas acessíveis sem isolamento." }
                ]
            },
            {
                nr: "NR-06",
                title: "NR-06: Equipamentos de Proteción Individual - EPI",
                badgeColor: "bg-purple-50 text-purple-700 border-purple-200",
                items: [
                    { id: "06.1", code: "Item 6.3", text: "Fornecimento Gratuito e Adequado: A empresa fornece aos trabalhadores os EPIs adequados ao risco, em perfeito estado de conservação." },
                    { id: "06.2", code: "Item 6.6.1", text: "Certificado de Aprovação (CA): Todos os EPIs utilizados possuem CA válido junto ao órgão competente do MTE." },
                    { id: "06.3", code: "Item 6.6.1 'd'", text: "Utilização Efetiva: Trabalhadores utilizam os EPIs exigidos para a função de forma correta e contínua." },
                    { id: "06.4", code: "Item 6.6.1 'e'", text: "Higienização e Guarda: Condições adequadas de higienização, manutenção periódica e guarda dos EPIs disponibilizados." }
                ]
            },
            {
                nr: "NR-17",
                title: "NR-17: Ergonomia",
                badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-200",
                items: [
                    { id: "17.1", code: "Item 17.2.1", text: "Mobiliário do Posto de Trabalho: Assentos e bancadas ajustáveis à estatura do trabalhador e à natureza da tarefa executada." },
                    { id: "17.2", code: "Item 17.5.1", text: "Iluminação do Posto: Iluminação geral e suplementar adequada, distribuída uniformemente, sem ofuscamentos ou reflexos incômodos." },
                    { id: "17.3", code: "Item 17.3.2", text: "Organização do Trabalho: Esforços físicos intensos, exigência de repetitividade excessiva ou posturas inadequadas mitigados por pausas e rodízio." },
                    { id: "17.4", code: "Item 17.6.1", text: "Transporte e Manuseio de Cargas: Peso e manuseio de materiais respeitam os limites legais de esforço físico, contando com auxílios mecânicos." }
                ]
            },
            {
                nr: "NR-23",
                title: "NR-23: Proteção Contra Incêndios",
                badgeColor: "bg-rose-50 text-rose-700 border-rose-200",
                items: [
                    { id: "23.1", code: "Item 23.1.1", text: "Extintores de Incêndio: Extintores adequados à classe de fogo da área, carregados, inspecionados no prazo e com lacres íntegros." },
                    { id: "23.2", code: "Item 23.3.2", text: "Desobstrução de Equipamentos: Acessos e áreas ao redor dos extintores e hidrantes totalmente livres e desobstruídos." },
                    { id: "23.3", code: "Item 23.5.1", text: "Rotas de Fuga e Saídas: Saídas de emergência e rotas de fuga sinalizadas, desimpedidas e com portas abrindo no sentido do fluxo de saída." },
                    { id: "23.4", code: "Item 23.7.1", text: "Iluminação de Emergência: Blocos autônomos ou sistema de iluminação de emergência operantes nas rotas de abandono." }
                ]
            }
        ];

        // Application State State Storage
        let auditMasterState = {
            info: {
                empresa: "",
                posto: "",
                tag: "",
                setor: "",
                inspetor: "",
                data: new Date().toISOString().split('T')[0],
                responsavel: "",
                parecer: "Aprovado / Liberado"
            },
            items: {} // { "12.1": { status: "C", obs: "...", prazo: "...", photo: "..." } }
        };

        let currentFilter = 'ALL';

        function initApp() {
            const saved = localStorage.getItem('safetyaudit_master_state');
            if (saved) {
                try {
                    auditMasterState = JSON.parse(saved);
                } catch(e) { console.error("Erro ao carregar estado", e); }
            }

            // Populate header inputs
            document.getElementById('info-empresa').value = auditMasterState.info.empresa || '';
            document.getElementById('info-posto').value = auditMasterState.info.posto || '';
            document.getElementById('info-tag').value = auditMasterState.info.tag || '';
            document.getElementById('info-setor').value = auditMasterState.info.setor || '';
            document.getElementById('info-inspetor').value = auditMasterState.info.inspetor || '';
            document.getElementById('info-data').value = auditMasterState.info.data || new Date().toISOString().split('T')[0];
            document.getElementById('info-responsavel').value = auditMasterState.info.responsavel || '';
            document.getElementById('info-parecer').value = auditMasterState.info.parecer || 'Aprovado / Liberado';

            renderChecklist();
            updateDashboard();
        }

        function saveInfo() {
            auditMasterState.info.empresa = document.getElementById('info-empresa').value;
            auditMasterState.info.posto = document.getElementById('info-posto').value;
            auditMasterState.info.tag = document.getElementById('info-tag').value;
            auditMasterState.info.setor = document.getElementById('info-setor').value;
            auditMasterState.info.inspetor = document.getElementById('info-inspetor').value;
            auditMasterState.info.data = document.getElementById('info-data').value;
            auditMasterState.info.responsavel = document.getElementById('info-responsavel').value;
            auditMasterState.info.parecer = document.getElementById('info-parecer').value;
            persistState();
        }

        function persistState() {
            localStorage.setItem('safetyaudit_master_state', JSON.stringify(auditMasterState));
            updateDashboard();
        }

        function setStatus(itemId, status) {
            if (!auditMasterState.items[itemId]) {
                auditMasterState.items[itemId] = { status: '', obs: '', prazo: '', photo: '' };
            }
            if (auditMasterState.items[itemId].status === status) {
                auditMasterState.items[itemId].status = '';
            } else {
                auditMasterState.items[itemId].status = status;
            }
            persistState();
            renderChecklist();
        }

        function updateObs(itemId, val) {
            if (!auditMasterState.items[itemId]) {
                auditMasterState.items[itemId] = { status: '', obs: '', prazo: '', photo: '' };
            }
            auditMasterState.items[itemId].obs = val;
            persistState();
        }

        function updatePrazo(itemId, val) {
            if (!auditMasterState.items[itemId]) {
                auditMasterState.items[itemId] = { status: '', obs: '', prazo: '', photo: '' };
            }
            auditMasterState.items[itemId].prazo = val;
            persistState();
        }

        function handlePhoto(itemId, event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    if (!auditMasterState.items[itemId]) {
                        auditMasterState.items[itemId] = { status: '', obs: '', prazo: '', photo: '' };
                    }
                    auditMasterState.items[itemId].photo = e.target.result;
                    persistState();
                    renderChecklist();
                };
                reader.readAsDataURL(file);
            }
        }

        function removePhoto(itemId) {
            if (auditMasterState.items[itemId]) {
                auditMasterState.items[itemId].photo = '';
                persistState();
                renderChecklist();
            }
        }

        function openModal(src) {
            document.getElementById('modal-img').src = src;
            document.getElementById('image-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('image-modal').classList.add('hidden');
        }

        function setFilter(filter) {
            currentFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(btn => {
                btn.className = "filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
            });
            if (filter === 'NC') {
                document.getElementById(`filter-btn-NC`).className = "filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white shadow-sm transition";
            } else {
                document.getElementById(`filter-btn-${filter}`).className = "filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white shadow-sm transition";
            }
            renderChecklist();
        }

        function renderChecklist() {
            const container = document.getElementById('nr-sections-container');
            const query = document.getElementById('search-input').value.toLowerCase();
            container.innerHTML = '';

            let totalRendered = 0;

            safetyDatabase.forEach(section => {
                let sectionHtml = '';
                let visibleCount = 0;

                section.items.forEach(item => {
                    const st = auditMasterState.items[item.id] || { status: '', obs: '', prazo: '', photo: '' };

                    // Filter condition
                    if (currentFilter !== 'ALL' && st.status !== currentFilter) {
                        return;
                    }

                    // Search condition
                    if (query && !item.text.toLowerCase().includes(query) && !item.id.toLowerCase().includes(query) && !item.code.toLowerCase().includes(query) && !section.nr.toLowerCase().includes(query)) {
                        return;
                    }

                    visibleCount++;
                    totalRendered++;

                    const isC = st.status === 'C';
                    const isNC = st.status === 'NC';
                    const isNA = st.status === 'NA';

                    sectionHtml += `
                        <div class="p-6 transition hover:bg-slate-50/70 border-b border-slate-100 last:border-b-0 space-y-4">
                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-xs font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">${item.id}</span>
                                        <span class="text-xs text-slate-500 font-semibold">${item.code}</span>
                                    </div>
                                    <p class="text-sm text-slate-800 font-medium leading-relaxed">${item.text}</p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0 self-start lg:self-center">
                                    <button type="button" onclick="setStatus('${item.id}', 'C')" class="px-3.5 py-2 text-xs font-bold rounded-xl border transition flex items-center gap-1.5 ${isC ? 'bg-emerald-600 text-white border-emerald-600 shadow-md ring-2 ring-emerald-600/20' : 'bg-white text-slate-600 border-slate-300 hover:bg-emerald-50 hover:text-emerald-700'}">
                                        <i class="fa-solid fa-check"></i> C
                                    </button>
                                    <button type="button" onclick="setStatus('${item.id}', 'NC')" class="px-3.5 py-2 text-xs font-bold rounded-xl border transition flex items-center gap-1.5 ${isNC ? 'bg-rose-600 text-white border-rose-600 shadow-md ring-2 ring-rose-600/20' : 'bg-white text-slate-600 border-slate-300 hover:bg-rose-50 hover:text-rose-700'}">
                                        <i class="fa-solid fa-xmark"></i> NC
                                    </button>
                                    <button type="button" onclick="setStatus('${item.id}', 'NA')" class="px-3.5 py-2 text-xs font-bold rounded-xl border transition flex items-center gap-1.5 ${isNA ? 'bg-amber-500 text-white border-amber-500 shadow-md ring-2 ring-amber-500/20' : 'bg-white text-slate-600 border-slate-300 hover:bg-amber-50 hover:text-amber-700'}">
                                        <i class="fa-solid fa-ban"></i> NA
                                    </button>
                                </div>
                            </div>

                            <!-- Observations, Corrective Action / Deadline & Photo Evidence -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-3 border-t border-slate-100">
                                <div class="md:col-span-2 space-y-3">
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1">
                                            <i class="fa-solid fa-pen-to-square mr-1 text-slate-400"></i> Observações / Plano de Ação Corretiva / Requisito Violado
                                        </label>
                                        <input type="text" value="${st.obs || ''}" oninput="updateObs('${item.id}', this.value)" placeholder="Descreva a não conformidade ou ação..." class="w-full text-xs rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div class="w-1/2">
                                            <label class="block text-xs font-semibold text-slate-500 mb-1">
                                                <i class="fa-solid fa-calendar-days mr-1 text-slate-400"></i> Prazo de Adequação
                                            </label>
                                            <input type="date" value="${st.prazo || ''}" onchange="updatePrazo('${item.id}', this.value)" class="w-full text-xs rounded-lg border border-slate-300 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col justify-between">
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1">
                                            <i class="fa-solid fa-camera mr-1 text-slate-400"></i> Evidência Fotográfica
                                        </label>
                                        <div class="flex items-center gap-2">
                                            <label class="cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-lg text-xs font-semibold border border-slate-300 transition flex items-center gap-1.5">
                                                <i class="fa-solid fa-upload"></i> Anexar Foto
                                                <input type="file" accept="image/*" class="hidden" onchange="handlePhoto('${item.id}', event)">
                                            </label>
                                            <span class="text-xs text-slate-400 italic">${st.photo ? 'Foto anexada' : 'Nenhuma foto'}</span>
                                        </div>
                                    </div>
                                    ${st.photo ? `
                                        <div class="relative group mt-2 inline-block">
                                            <img src="${st.photo}" onclick="openModal('${st.photo}')" class="h-14 w-14 rounded-lg object-cover border border-slate-300 cursor-pointer shadow-sm hover:opacity-95 transition">
                                            <button onclick="removePhoto('${item.id}')" title="Remover Foto" class="absolute -top-2 -right-2 bg-rose-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] shadow hover:bg-rose-700">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                });

                if (visibleCount > 0) {
                    container.innerHTML += `
                        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden print-shadow">
                            <div class="bg-slate-100 px-6 py-4 border-b border-slate-200 flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="text-xs font-bold px-2.5 py-1 rounded-lg border ${section.badgeColor}">${section.nr}</span>
                                    <h3 class="font-bold text-slate-900 text-sm md:text-base">${section.title}</h3>
                                </div>
                                <span class="text-xs font-bold text-slate-600 bg-white px-2.5 py-1 rounded-lg border border-slate-200 shadow-sm">${visibleCount} itens</span>
                            </div>
                            <div class="divide-y divide-slate-100">
                                ${sectionHtml}
                            </div>
                        </div>
                    `;
                }
            });

            if (totalRendered === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 text-slate-400">
                        <i class="fa-solid fa-folder-open text-4xl mb-3 text-slate-300"></i>
                        <p class="text-sm font-medium">Nenhum item encontrado para o filtro ou pesquisa selecionados.</p>
                    </div>
                `;
            }
        }

        function updateDashboard() {
            let total = 0;
            let cCount = 0;
            let ncCount = 0;
            let naCount = 0;

            safetyDatabase.forEach(sec => {
                sec.items.forEach(item => {
                    total++;
                    const st = auditMasterState.items[item.id]?.status;
                    if (st === 'C') cCount++;
                    else if (st === 'NC') ncCount++;
                    else if (st === 'NA') naCount++;
                });
            });

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-c').innerText = cCount;
            document.getElementById('stat-nc').innerText = ncCount;
            document.getElementById('stat-na').innerText = naCount;

            const evaluated = cCount + ncCount;
            const pct = evaluated > 0 ? Math.round((cCount / evaluated) * 100) : 0;
            document.getElementById('stat-pct').innerText = pct + '%';
            document.getElementById('stat-bar').style.width = pct + '%';
        }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(auditMasterState, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `auditoria_multi_nr_${auditMasterState.info.tag || 'posto'}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function resetChecklist() {
            if (confirm("Tem certeza que deseja zerar todos os dados e respostas desta auditoria integrada?")) {
                localStorage.removeItem('safetyaudit_master_state');
                auditMasterState = {
                    info: { empresa: "", posto: "", tag: "", setor: "", inspetor: "", data: new Date().toISOString().split('T')[0], responsavel: "", parecer: "Aprovado / Liberado" },
                    items: {}
                };
                initApp();
            }
        }

        window.onload = initApp;
    </script>

</body>
</html>